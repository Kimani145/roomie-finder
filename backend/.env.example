# ─── Fly.io [env] in fly.toml (non-secret) ───────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://tuk-roomie-finder.vercel.app
LOG_LEVEL=info

# SMTP host/port/from can live in fly.toml; credentials must be secrets (below).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=Roomie Finder <no-reply@roomiefinder.app>

# ─── Fly secrets (fly secrets set ...) ───────────────────────────────────────
# Never commit real values. Set these after `fly deploy`:
#
#   fly secrets set \
#     FIREBASE_PROJECT_ID=... \
#     FIREBASE_CLIENT_EMAIL=... \
#     FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" \
#     SMTP_USER=... \
#     SMTP_PASSWORD=...
#
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMTP_USER=*****@smtp-brevo.com
SMTP_PASSWORD=update_with_brevo_password

# ─── Local development ───────────────────────────────────────────────────────
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173
