rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // CORE SECURITY FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAllowedStudentEmail() {
      return request.auth.token.email is string
        && (
          request.auth.token.email.lower().matches('.*@students[.]tukenya[.]ac[.]ke$')
          || request.auth.token.email.lower().matches('.*@tukenya[.]ac[.]ke$')
        );
    }

    function isVerifiedStudent() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && hasAllowedStudentEmail();
    }

    function isOwner(userId) {
      // Removed isVerifiedStudent() so unverified users fetching their own metadata don't trigger permission-denied crashes.
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(participantsArray) {
      return isVerifiedStudent() && request.auth.uid in participantsArray;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.systemRole == 'SUPER_ADMIN';
    }

    // Temporary dev seeder gate. Remove before production hardening.
    function isDevSeeder() {
      return false;
    }

    function isSeedUserId(userId) {
      return userId.matches('^seed-user-[0-9]{3}$');
    }

    function isSeedListingId(listingId) {
      return listingId.matches('^listing-seed-user-[0-9]{3}$');
    }

    function validUserDoc(data) {
      return data.keys().hasOnly(['role', 'profileCompleted', 'updatedAt'])
        && data.role in ['HOST', 'SEEKER', 'FLEX'];
    }

    function validProfileDoc(data) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'role', 'gender', 'age', 'school', 'courseYear',
          'minBudget', 'maxBudget', 'zones', 'preferredRoomType', 'lifestyle', 'dealBreakers',
          'status', 'lastActive', 'createdAt', 'bio', 'bioQuote', 'moveInMonth', 'updatedAt',
          'twoFactorEnabled'
        ])
        && data.keys().hasAll([
          'displayName', 'role', 'gender', 'age', 'school', 'courseYear',
          'minBudget', 'maxBudget', 'zones', 'preferredRoomType', 'lifestyle', 'dealBreakers',
          'status', 'lastActive', 'createdAt'
        ])
        && data.role in ['HOST', 'SEEKER', 'FLEX']
        && data.status in ['active', 'inactive', 'paused']
        && data.lifestyle is map
        && data.lifestyle.keys().hasOnly(['sleepTime', 'noiseTolerance', 'guestFrequency', 'cleanlinessLevel', 'studyStyle', 'smoking', 'alcohol'])
        && data.dealBreakers is map
        && data.dealBreakers.keys().hasOnly(['noSmokingRequired', 'noAlcoholRequired', 'noPetsRequired', 'mustHaveWiFi', 'femaleOnly', 'maleOnly']);
    }

    function validProfilePreviewDoc(data) {
      return data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'role', 'zones', 'bioQuote']);
    }

    function validListingDoc(data) {
      return data.keys().hasOnly([
          'id',
          'hostId',
          'zone',
          'housingType',
          'rentTotal',
          'roommateShare',
          'amenities',
          'photos',
          'houseRules',
          'createdAt',
          'status',
          'interestCount',
          'viewCount',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'id',
          'hostId',
          'zone',
          'housingType',
          'rentTotal',
          'roommateShare',
          'amenities',
          'photos',
          'houseRules',
          'createdAt',
          'status'
        ])
        && data.status in ['active', 'paused', 'filled']
        && data.houseRules is map
        && data.houseRules.keys().hasOnly([
          'smokingAllowed',
          'petsAllowed',
          'guestPolicy'
        ]);
    }

    function canonicalMatchId(userA, userB) {
      return userA < userB ? userA + '_' + userB : userB + '_' + userA;
    }

    // =========================================================================
    // USERS
    // =========================================================================
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSuperAdmin()
        || (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['twoFactorEnabled', 'lastActive', 'status']));
      // Admin creation is now owned by the backend (InvitationService).
      // Keeping the rule for the invitation acceptance flow which runs client-side.
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasAll(['systemRole', 'email', 'status', 'token'])
        && exists(/databases/$(database)/documents/admin_invitations/$(request.resource.data.token))
        && get(/databases/$(database)/documents/admin_invitations/$(request.resource.data.token)).data.email == request.auth.token.email
        && request.resource.data.systemRole == get(/databases/$(database)/documents/admin_invitations/$(request.resource.data.token)).data.role;
    }

    match /admin_invitations/{token} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if resource.data.status == 'pending'
        && request.resource.data.status == 'accepted';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (
          isOwner(userId)
          || (isDevSeeder() && isSeedUserId(userId))
        )
        && validUserDoc(request.resource.data);
      allow update: if ((
          isOwner(userId)
          || (isDevSeeder() && isSeedUserId(userId))
        )
        && validUserDoc(request.resource.data)) || isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // PROFILES
    // =========================================================================
    match /profiles/{userId} {
      allow read: if isVerifiedStudent();
      allow create: if isOwner(userId) && isVerifiedStudent() && validProfileDoc(request.resource.data);
      allow update: if (isOwner(userId) && isVerifiedStudent() && validProfileDoc(request.resource.data))
        || isAdmin();
    }

    // =========================================================================
    // TWO-FACTOR AUTHENTICATION (OTP)
    // =========================================================================
    match /otps/{email} {
      allow read, write: if isSignedIn() && request.auth.token.email == email;
    }

    // =========================================================================
    // AUDIT LOGS
    // =========================================================================
    // BACKEND AUTHORITY: All audit logs are written by the backend (Admin SDK).
    // Clients can only READ (admins only). No client writes permitted.
    match /auditLogs/{logId} {
      allow create: if false;         // Backend only — Admin SDK bypasses this rule
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable
    }

    match /profilePreviews/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isVerifiedStudent()
        && validProfilePreviewDoc(request.resource.data)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // =========================================================================
    // LISTINGS
    // =========================================================================
    match /listings/{listingId} {
      allow read: if true;

      allow create: if isVerifiedStudent()
        && request.resource.data.hostId == request.auth.uid
        && validListingDoc(request.resource.data);

      // Updates: host owns their listing, OR any verified student increments counters.
      // interestCount is also incremented by the backend MatchService (Admin SDK bypasses).
      allow update: if isVerifiedStudent()
        && (
          (
            resource.data.hostId == request.auth.uid
            && request.resource.data.hostId == request.auth.uid
            && validListingDoc(request.resource.data)
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestCount', 'viewCount'])
            && request.resource.data.hostId == resource.data.hostId
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['interestCount'])
              || request.resource.data.interestCount == resource.data.get('interestCount', 0) + 1)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount'])
              || request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1)
            && validListingDoc(request.resource.data)
          )
        );

      allow delete: if isVerifiedStudent() && resource.data.hostId == request.auth.uid;
    }

    // =========================================================================
    // LIKES
    // =========================================================================
    // BACKEND AUTHORITY: Likes are created by the MatchService (Admin SDK).
    // Clients can READ their own likes only (needed for hasLiked() check in UI).
    match /likes/{likeId} {
      // Read: users can check if a like exists involving them (UI state only)
      allow read: if isVerifiedStudent()
        && (
          likeId.matches('^' + request.auth.uid + '_.*')
          || likeId.matches('.*_' + request.auth.uid + '$')
        );

      // BACKEND AUTHORITY: No client writes to likes
      allow create: if false;   // MatchService (Admin SDK) creates all likes
      allow update, delete: if false; // Immutable interaction record
    }

    // =========================================================================
    // MATCHES
    // =========================================================================
    // BACKEND AUTHORITY: Matches are created by the MatchService (Admin SDK).
    // Clients can only READ matches they participate in.
    match /matches/{matchId} {
      // Read: ID-based short-circuit first to avoid null resource error on non-existent docs.
      // Falls back to participants array check for docs that exist.
      allow read: if isVerifiedStudent() && (
        matchId.matches('^match_.*_' + request.auth.uid + '$') ||
        matchId.matches('^match_' + request.auth.uid + '_.*') ||
        matchId.matches('^' + request.auth.uid + '_.*') ||
        matchId.matches('.*_' + request.auth.uid + '$') ||
        isAdmin() ||
        (resource != null && resource.data != null && request.auth.uid in resource.data.participants)
      );

      // BACKEND AUTHORITY: No client writes to matches
      allow create: if false;   // MatchService (Admin SDK) creates all matches
      allow update: if false;   // Matches are immutable from the client
      allow delete: if false;
    }

    // =========================================================================
    // CHATS + MESSAGES
    // =========================================================================
    // BACKEND AUTHORITY: Chat documents are created by the MatchService (Admin SDK).
    // Clients can read and update (lastMessage, etc.) for chats they participate in.
    match /chats/{chatId} {
      allow read, update: if isParticipant(resource.data.participants);

      // BACKEND AUTHORITY: No client creates for chat documents
      allow create: if false;   // MatchService (Admin SDK) creates all chats

      match /messages/{messageId} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isVerifiedStudent()
          && isParticipant(
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // ZONES
    // =========================================================================
    match /zones/{zoneId} {
      allow read: if isVerifiedStudent();
      allow write: if isDevSeeder();
    }

    // =========================================================================
    // REPORTS (TRUST & SAFETY)
    // =========================================================================
    match /reports/{reportId} {
      allow create: if isVerifiedStudent()
        && request.resource.data.keys().hasAll(['reportedUserId', 'reportedBy', 'reason', 'status', 'createdAt']);
      allow read, update: if isAdmin();
      allow delete: if false; // Never delete audit trails
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    // BACKEND AUTHORITY: Notifications are created by the backend (NotificationService via Admin SDK).
    // Clients can READ and UPDATE (mark as read) their own notifications only.
    match /notifications/{notificationId} {
      // Recipients can read and delete their own notifications
      allow read, delete: if isVerifiedStudent()
        && resource.data.recipientId == request.auth.uid;

      // BACKEND AUTHORITY: No client creates for notifications
      allow create: if false;   // NotificationService (Admin SDK) creates all notifications

      // Recipients can only update isRead
      allow update: if isVerifiedStudent()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
