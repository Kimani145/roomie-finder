# ─── Vercel (production) ─────────────────────────────────────────────────────
# Firebase client config — PUBLIC, bundled into the browser bundle.
# The frontend talks to Firebase Auth + Firestore directly; the backend uses
# Firebase Admin only for privileged server-side operations (email links, admin).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Trusted backend (Fly.io in production)
VITE_API_BASE_URL=https://roomie-finder-backend.fly.dev

# Cloudinary unsigned uploads (client-side; preset must allow unsigned uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=roomie_unsigned

# ─── Local development only ──────────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8080
# VITE_USE_EMULATOR=true
